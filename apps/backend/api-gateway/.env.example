# =============================================================
# APP
# =============================================================
# Port the NestJS server listens on (defaults to 3000 if unset)
PORT=3000

# =============================================================
# SUPABASE - PostgreSQL Connection
# =============================================================
# IMPORTANT: Both variables must be set for Prisma + Supabase to work correctly.
#
# - DATABASE_URL  → Uses Supabase's connection pooler (PgBouncer, port 6543).
#                   This is what Prisma uses at runtime for all queries.
#                   Add ?pgbouncer=true&connection_limit=1 at the end.
#
# - DIRECT_URL    → Direct connection to the DB (port 5432, no pooler).
#                   Prisma uses this ONLY when running migrations (prisma migrate dev).
#
# You can get both URLs from:
# Supabase Dashboard → Project Settings → Database → Connection string

# Pooled connection (for runtime / API queries)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# =============================================================
# SUPABASE AUTH
# =============================================================
# Get these from: Supabase Dashboard → Project Settings → API

SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# =============================================================
# JWT
# =============================================================
# Must match the JWT Secret found at:
# Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret

JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"
